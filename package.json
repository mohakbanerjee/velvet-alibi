{
  "name": "kanecli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kane:check": "node scripts/kane-check.mjs",
    "kane:smoke": "node scripts/kane-check.mjs --tag=smoke",
    "kane:watch": "node scripts/kane-watch.mjs",
    "kane:suite": "kane-cli testrun run --match flows --headless --agent",
    "kane:hook:on": "node scripts/kane-hook.mjs on",
    "kane:hook:all": "node scripts/kane-hook.mjs all",
    "kane:hook:off": "node scripts/kane-hook.mjs off",
    "kane:hook:headed": "node scripts/kane-hook.mjs headed",
    "kane:hook:headless": "node scripts/kane-hook.mjs headless",
    "demo:plant-bug": "node scripts/demo-bug.mjs plant",
    "demo:unplant-bug": "node scripts/demo-bug.mjs unplant",
    "demo:bug-status": "node scripts/demo-bug.mjs status"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^6.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
