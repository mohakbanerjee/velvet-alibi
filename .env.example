# Optional. Only needed if `kane-cli login` (browser sign in) does not work for you.
# Copy this file to .env.local and fill in from TestMu AI dashboard > Credentials. Never commit .env.local.
LT_USERNAME=
LT_ACCESS_KEY=
# Optional: run Kane against another URL, for example your Vercel deploy
KANE_BASE_URL=http://localhost:3000
